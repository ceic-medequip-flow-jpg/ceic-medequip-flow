  const h = Math.floor(mins / 60);
  const d = Math.floor(h / 24);
  const hh = h % 24;
  const mm = mins % 60;
  if (d > 0) return `${d}d ${pad2(hh)}h`;
  return `${pad2(h)}h ${pad2(mm)}m`;
}
